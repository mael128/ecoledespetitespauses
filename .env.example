# --- GitHub OAuth App (for admin login) ---
# Create at https://github.com/settings/developers (New OAuth App)
# Callback URL: https://<your-vercel-domain>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Comma-separated list of GitHub usernames allowed to sign in to /admin
ALLOWED_GITHUB_LOGINS=mael128,mael12854

# next-auth session encryption secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=

# Only needed for local dev; Vercel sets this automatically in production
NEXTAUTH_URL=http://localhost:3000

# --- Personal Access Token used server-side to commit content changes ---
# Fine-grained PAT scoped to this repo only, with "Contents: Read and write" permission.
# Never exposed to the browser — used only inside app/api/admin/* route handlers.
GH_COMMIT_TOKEN=
GH_REPO_OWNER=mael128
GH_REPO_NAME=ecoledespetitespauses
GH_BRANCH=main
