# Nothing here is required to get the site running — it works with zero
# env vars. These only matter if you fork this to a differently-named repo
# or branch (the admin panel's GitHub token is pasted in the browser at
# use-time, not stored as a server secret — see README.md).
GH_REPO_OWNER=mael128
GH_REPO_NAME=ecoledespetitespauses
GH_BRANCH=main
